# Copie para .env e ajuste. Nao versione o .env.

# Conexão da APLICAÇÃO (role sujeita a RLS). Usada por boardos/db.py e a API.
BOARDOS_DSN=postgresql://boardos_app:change-me@localhost:5432/boardos

# Conexão ADMIN (migrações, criação de tenant, dim_calendario). Sem RLS.
BOARDOS_ADMIN_DSN=postgresql://boardos_admin:change-me-admin@localhost:5432/boardos
